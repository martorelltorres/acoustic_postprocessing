<launch>
    <!-- ****************** MULTIBEAM PROCESSOR ****************** -->
    
    <!-- <arg name="mb_bagfile" default="/home/uib/bagfiles/cabrera/2025_10_28/14_44_35/sparus2_multibeam_2025-10-28-14-44-35_0.bag"/>
    <arg name="sss_bagfile" default="/home/uib/bagfiles/cabrera/2025_10_28/10_56_48/sparus2_sidescan_2025-10-28-10-56-48_0.bag"/> -->

    <!-- El sec -->
    <!-- <arg name="mb_bagfile" default="/home/uib/bagfiles/El_Sec/toni/10_18_53/sparus2_multibeam_2025-11-10-10-18-53_0.bag"/> -->
    <!-- <arg name="mb_bagfile" default="/home/uib/bagfiles/El_Sec/toni/sparus2_multibeam_2025-11-10-11-31-34_0.bag"/> -->
   
    
    <!-- MINEX DERELICTES -->
    <arg name="mb_bagfile" default="/media/uib/Datos/bagfiles/MINEX/2026/20260507_sparus2_uib_portopi_shipwrecks_and_harbour_entrance/bags/sparus2_multibeam_2026-05-07-06-42-24_0.bag"/> 
    <!-- MINEX ESTRENC -->
    <!-- <arg name="mb_bagfile" default="/media/uib/Datos/bagfiles/MINEX/2026/20260504_sparus2_uib_orat_spanish_minex_portopi/bags/sparus2_multibeam_2026-05-04-13-59-52_0.bag"/>  -->
    <!-- <arg name="mb_bagfile" default="/media/uib/Datos/bagfiles/MINEX/2026/20260507_sparus2_uib_portopi_shipwrecks_and_harbour_entrance/bags/sparus2_multibeam_2026-05-07-06-42-24_0.bag"/> -->
    <!-- <arg name="sss_bagfile" default="/media/uib/Datos/bagfiles/MINEX/2026/20260507_sparus2_uib_portopi_shipwrecks_and_harbour_entrance/bags/sparus2_sidescan_2026-05-07-07-11-18_0.bag"/>  -->

<!-- sss -->
<!-- sparus2_sidescan_2026-05-07-07-11-18_0.bag derelictes-->
<!-- sparus2_sidescan_2026-05-07-07-46-31_0.bag sss+mb -->

<!-- mb -->
<!-- sparus2_multibeam_2026-05-07-06-42-24_0.bag derelictes -->
    
    <arg name="output_dir" default="/home/uib/derelictes_ws/src/acoustic_postprocessing/results/"/>
    <arg name="robot_name" default="sparus2"/>
    <arg name="sor_k" default="50"/>
    <arg name="sor_std" default="1.0"/>
    <arg name="voxel_size" default="0.01"/>
    <!-- registration_algorithm: icp | colored_icp | hybrid | ndt
         hybrid = geometría donde hay relieve, intensidad donde el fondo es liso -->
    <arg name="registration_algorithm"        default="hybrid"/>
    <!-- Colored ICP: peso geométrico (1.0=solo geometría, menor=más intensidad) -->
    <arg name="colored_icp_lambda"            default="0.6"/>
    <!-- hybrid: fracción mínima de relieve para usar geometría (si no, intensidad) -->
    <arg name="hybrid_min_texture"            default="0.2"/>
    <!-- Sequential ICP–navigation consistency gates -->
    <arg name="max_seq_icp_translation_dev"  default="0.5"/>
    <arg name="max_seq_icp_yaw_dev"          default="15.0"/>
    <!-- Fix A: ICP translation length-ratio band (rescale to INS if outside) -->
    <arg name="min_seq_icp_length_ratio"     default="0.85"/>
    <arg name="max_seq_icp_length_ratio"     default="1.15"/>
    <!-- Anclaje de escala: la magnitud del paso viene del INS (fiable), el ICP
         solo aporta dirección. Desactivado: sube la corrección media. Se usa el
         gate de longitud (Fix A) con la banda de arriba. -->
    <arg name="seq_anchor_scale"             default="false"/>
    <arg name="ndt_resolution" default="1.0"/>
    <arg name="ndt_max_points" default="3000"/>
    <arg name="ndt_min_points_per_voxel" default="5"/>
    <arg name="enable_loop_closure" default="true"/>
    <!-- Loop closure validation gates -->
    <arg name="max_loop_ins_distance"      default="12.0"/>
    <arg name="min_loop_icp_ins_ratio"     default="0.40"/>
    <arg name="min_ins_dist_for_ratio_check" default="2.0"/>
    <!-- Gap temporal mínimo entre patches para ser candidato a loop closure. -->
    <arg name="min_loop_temporal_gap"        default="25"/>
    <arg name="enable_monitor" default="true"/>
    <arg name="monitor_zoom" default="0.18"/>
    <arg name="monitor_min_zoom" default="0.03"/>
    <arg name="monitor_margin" default="2.5"/>
    <!-- Capa de nubes en vivo (Opción C / VIS-002): muestra los últimos N
         patches alineados por su pose para ver el mapa construyéndose -->
    <arg name="monitor_show_clouds"  default="true"/>
    <arg name="monitor_cloud_window" default="15"/>
    <arg name="monitor_cloud_voxel"  default="0.4"/>

    <param name="use_sim_time" value="true"/>

    <include file="$(find sparus2_description)/launch/sparus2_description.launch">
        <arg name="robot_name" value="$(arg robot_name)"/>
    </include>


    
    <!-- <node pkg="acoustic_postprocessing" type="multibeam_processor.py" name="mb_multi_proc" output="screen" >
        <param name="bag_file"      value="$(arg mb_bagfile)" />
        <param name="scan_topic"    value="/sparus2/norbit_wbms_multibeam/multibeam_scan" />
        <param name="nav_topic"     value="/sparus2/navigator/navigation" />
        <param name="output_dir"    value="$(arg output_dir)" />      
        <param name="sor_k" value="$(arg sor_k)"/>
        <param name="sor_std" value="$(arg sor_std)"/>
        <param name="voxel_size" value="$(arg voxel_size)"/>
    </node> -->
    <node   pkg="acoustic_postprocessing"    type="multibeam_slam.py"    name="mb_slam"    output="screen">
        <param name="bag_file"      value="$(arg mb_bagfile)" />
        <param name="scan_topic"    value="/sparus2/norbit_wbms_multibeam/multibeam_scan" />
        <param name="nav_topic"     value="/sparus2/navigator/navigation" />
        <param name="output_dir"    value="$(arg output_dir)" />   
        <param name="registration_algorithm"       value="$(arg registration_algorithm)" />
        <param name="colored_icp_lambda"            value="$(arg colored_icp_lambda)" />
        <param name="hybrid_min_texture"            value="$(arg hybrid_min_texture)" />
        <param name="max_seq_icp_translation_dev" value="$(arg max_seq_icp_translation_dev)" />
        <param name="max_seq_icp_yaw_dev"         value="$(arg max_seq_icp_yaw_dev)" />
        <param name="min_seq_icp_length_ratio"    value="$(arg min_seq_icp_length_ratio)" />
        <param name="max_seq_icp_length_ratio"    value="$(arg max_seq_icp_length_ratio)" />
        <param name="seq_anchor_scale"            value="$(arg seq_anchor_scale)" />
        <param name="ndt_resolution" value="$(arg ndt_resolution)" />
        <param name="ndt_max_points" value="$(arg ndt_max_points)" />
        <param name="ndt_min_points_per_voxel" value="$(arg ndt_min_points_per_voxel)" />
        <param name="enable_loop_closure"          value="$(arg enable_loop_closure)" />
        <param name="max_loop_ins_distance"         value="$(arg max_loop_ins_distance)" />
        <param name="min_loop_icp_ins_ratio"        value="$(arg min_loop_icp_ins_ratio)" />
        <param name="min_ins_dist_for_ratio_check"  value="$(arg min_ins_dist_for_ratio_check)" />
        <param name="min_loop_temporal_gap"         value="$(arg min_loop_temporal_gap)" />
        <param name="enable_monitor" value="$(arg enable_monitor)" />
        <param name="monitor_zoom" value="$(arg monitor_zoom)" />
        <param name="monitor_min_zoom" value="$(arg monitor_min_zoom)" />
        <param name="monitor_margin" value="$(arg monitor_margin)" />
        <param name="monitor_show_clouds"  value="$(arg monitor_show_clouds)" />
        <param name="monitor_cloud_window" value="$(arg monitor_cloud_window)" />
        <param name="monitor_cloud_voxel"  value="$(arg monitor_cloud_voxel)" />
    </node>

    <!-- <node pkg="acoustic_postprocessing" type="multibeam_icp_processor.py"  name="mb_icp_proc"  output="screen">
        <param name="bag_file" value="$(arg mb_bagfile)" />
        <param name="scan_topic"  value="/sparus2/norbit_wbms_multibeam/multibeam_scan" />
        <param name="nav_topic" value="/sparus2/navigator/navigation" />
        <param name="output_dir" value="$(arg output_dir)" />
        <param name="voxel_size" value="$(arg voxel_size)" />
        <param name="angle_cutoff_deg" value="50.0" />
        <param name="patch_scans" value="100" />
        <param name="visualize" value="false" />
    </node> -->

     <!-- ****************** SIDESCAN SONAR PROCESSOR ****************** -->

     <!-- <node pkg="acoustic_postprocessing" type="sss2mosaic.py" name="sss_mosaic_gen" output="screen" >
        <param name="bag_file" value="$(arg sss_bagfile)" />
        <param name="output_dir" value="$(arg output_dir)" />
        <param name="nav_topic"     value="/sparus2/navigator/navigation" />
    </node> -->

    <!-- <node pkg="acoustic_postprocessing" type="sss_waterfall.py" name="sss_waterfall_gen" output="screen">
        <param name="bag_file" value="$(arg sss_bagfile)" />
        <param name="output_dir" value="$(arg output_dir)" />
    </node>  -->

    <!-- <node pkg="acoustic_postprocessing" type="sss_mb_fusion.py" name="fusion_node" output="screen">
        <param name="mesh_file" value="$(arg output_dir)/mb_mesh.ply" />
        <param name="sss_tif"   value="$(arg output_dir)/sss_mosaic.tif" />
        <param name="output_dir" value="$(arg output_dir)" />
    </node>  -->

</launch>
